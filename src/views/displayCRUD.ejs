<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Get CRUD</title>
    <style>
        table {
          font-family: arial, sans-serif;
          border-collapse: collapse;
          width: 100%;
        }
        td, th {
          border: 1px solid #dddddd;
          text-align: left;
          padding: 8px;
        }
        tr:nth-child(even) {
          background-color: #dddddd;
        }
    </style>
</head>
<body>
    <table>
        <tr>
          <th>username</th>
          <th>firstname</th>
          <th>lastname</th>
          <th>phoneNumber</th>
          <th>birth</th>
          <th>gender</th>
          <th>email</th>
          <th>password</th>
        </tr>
       
        <% for (let i = 0; i < dataTable.length; i++) { %>
            <tr>
                <td><%= dataTable[i].userName %></td>
                <td><%= dataTable[i].firstName %></td>
                <td><%= dataTable[i].lastName %></td>
                <td><%= dataTable[i].phoneNumber %></td>
                <td><%= dataTable[i].birth %></td>
                <td><%= dataTable[i].gender %></td>
                <td><%= dataTable[i].email %></td>
                <td><%= dataTable[i].passWord %></td>
                <td>
                    <a href="/delete-crud?id=<%= dataTable[i].id %>" , >Delete</a>
                    <a href="/edit-crud?id=<%= dataTable[i].id %>" class = "btn-edit" type="button">Edit</a>
                </td>
            </tr>
        <% } %> <!-- 👈 thêm dòng này -->
    </table>
</body>
</html>
